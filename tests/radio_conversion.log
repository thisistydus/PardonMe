Input #0, mov,mp4,m4a,3gp,3g2,mj2, from '/Users/tydussimonini/Documents/Godot/PardonMe/Music/Warranty Void.m4a':
  Metadata:
    major_brand     : isom
    minor_version   : 512
    compatible_brands: isomiso2mp41
    encoder         : Lavf60.16.100
    lyrics          : [Intro]
                    : [Instrumental]
                    : [Verse 1]
                    : You slide in wearing midnight leather
                    : Keys like a promise in your hand
                    : I know the bridge is held by weather
                    : Still I tell you, baby, take command
                    : Your lipstick on the steering wheel
                    : My pulse is climbing past the red
                    : We don't need a map to know the deal
                    : We need a road and something said
                    : [Pre-Chorus]
                    : Check the mirror, check the spark
                    : Kiss me hard and miss the mark
                    : If the warning light comes on
                    : Baby, we'll be long gone
                    : [Chorus]
                    : Warranty void, warranty void
                    : You and me are built to be destroyed
                    : No return, no second choice
                    : Turn it up and hear the whole world voice
                    : Warranty void, warranty void
                    : You’re the sweetest risk I’ve ever enjoyed
                    : Bald tires screaming, claim denied
                    : Put your hands on me and take the ride
                    : [Verse 2]
                    : Registration expired in April
                    : Insurance says the file is closed
                    : The radiator's running fatal
                    : But you look too good to be opposed
                    : There’s a hairline crack beneath the spoiler
                    : There’s a siren somewhere in the heat
                    : You say the night belongs to spoilers
                    : I say the danger makes it sweet
                    : [Pre-Chorus]
                    : Check the mirror, check the spark
                    : Kiss me hard and miss the mark
                    : If the warning light comes on
                    : Baby, we'll be long gone
                    : [Chorus]
                    : Warranty void, warranty void
                    : You and me are built to be destroyed
                    : No return, no second choice
                    : Turn it up and hear the whole world voice
                    : Warranty void, warranty void
                    : You’re the sweetest risk I’ve ever enjoyed
                    : Bald tires screaming, claim denied
                    : Put your hands on me and take the ride
                    : [Breakdown]
                    : No coverage when the engine blows
                    : No mercy where the redline goes
                    : No paperwork can save this flame
                    : No adjuster wants to sign their name
                    : If the tires go bald, let ’em sing
                    : If the hood runs hot, let it swing
                    : If they ask who caused the wreck tonight
                    : Tell ’em we were born to cross that line
                    : [Guitar Solo]
                    : [Instrumental]
                    : [Chorus]
                    : Warranty void, warranty void
                    : You and me are built to be destroyed
                    : No return, no second choice
                    : Turn it up and hear the whole world voice
                    : Warranty void, warranty void
                    : You’re the sweetest risk I’ve ever enjoyed
                    : Bald tires screaming, claim denied
                    : Put your hands on me and take the ride
                    : [Final Chorus]
                    : Warranty void, warranty void
                    : Raise your fists for the reckless noise
                    : Missing plates and a burning sky
                    : If they ask, baby, tell them why
                    : Warranty void, warranty void
                    : Every kiss is a dangerous choice
                    : No registration, no alibi
                    : Love me fast and let the paperwork die
                    : [Outro]
                    : Warranty void!
                    : Warranty void!
                    : [Instrumental]
                    : [End]
    comment         : made with suno; created=2026-09-04T08:08:50Z; id=d9cfe5ff-01bb-450e-b1b9-d845d56ed280
